/* pages/mine/mine.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ffe4d6 0%, #fff5f0 30%, #f5f5f5 60%);
  padding-bottom: 120rpx;
}

/* 未登录状态 */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 60rpx;
}

.login-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
}

.login-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 50rpx;
}

.login-btn {
  width: 400rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.3);
}

/* 用户信息区域 */
.user-section {
  padding: 40rpx 30rpx;
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-right: 12rpx;
}

.member-badge {
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
  border-radius: 12rpx;
}

.crown-icon {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.member-text {
  font-size: 22rpx;
  color: #8b4513;
  font-weight: bold;
}

.greeting {
  font-size: 26rpx;
  color: #999;
}

/* 积分和会员卡片 */
.info-cards {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.info-card {
  flex: 1;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.card-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.card-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.card-label {
  font-size: 24rpx;
  color: #999;
}

.card-arrow {
  position: absolute;
  right: 24rpx;
  font-size: 48rpx;
  color: #d0d0d0;
  font-weight: 300;
}

/* 会员推广卡片 */
.member-promo {
  background: linear-gradient(135deg, #3d3d3d 0%, #2a2a2a 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.promo-left {
  display: flex;
  align-items: center;
}

.promo-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.promo-text {
  display: flex;
  flex-direction: column;
}

.promo-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.promo-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.promo-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.3);
}

.promo-btn-text {
  font-size: 28rpx;
  color: #8b4513;
  font-weight: bold;
  margin-right: 8rpx;
}

.promo-btn-arrow {
  font-size: 24rpx;
  color: #8b4513;
}

/* 会员推广卡片（非会员 - 大卡片） */
.member-promo-large {
  background: linear-gradient(135deg, #3d3d3d 0%, #2a2a2a 100%);
  border-radius: 20rpx;
  padding: 40rpx 30rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.promo-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.promo-icon-large {
  font-size: 72rpx;
  margin-right: 24rpx;
}

.promo-text-large {
  display: flex;
  flex-direction: column;
}

.promo-title-large {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.promo-subtitle-large {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.promo-benefits {
  margin-bottom: 30rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.benefit-item:last-child {
  margin-bottom: 0;
}

.benefit-icon {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background-color: rgba(255, 215, 0, 0.2);
  color: #ffd700;
  border-radius: 50%;
  font-size: 20rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.benefit-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.promo-btn-large {
  padding: 20rpx 40rpx;
  background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.3);
}

.promo-btn-text-large {
  font-size: 30rpx;
  color: #8b4513;
  font-weight: bold;
  margin-right: 8rpx;
}

.promo-btn-arrow-large {
  font-size: 26rpx;
  color: #8b4513;
}

/* 菜单列表 */
.menu-list {
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin: 0 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-title {
  font-size: 32rpx;
  color: #333;
}

.menu-arrow {
  font-size: 48rpx;
  color: #d0d0d0;
  font-weight: 300;
}
