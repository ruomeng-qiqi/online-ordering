<!--pages/order/order.wxml-->
<view class="page">
  <!-- 顶部筛选栏 -->
  <view class="filter-bar">
    <view 
      class="filter-item {{currentFilter === 0 ? 'active' : ''}}"
      bindtap="switchFilter"
      data-status="{{0}}">
      <text class="filter-text">全部</text>
    </view>
    <view 
      class="filter-item {{currentFilter === 1 ? 'active' : ''}}"
      bindtap="switchFilter"
      data-status="{{1}}">
      <text class="filter-text">待支付</text>
    </view>
    <view 
      class="filter-item {{currentFilter === 2 ? 'active' : ''}}"
      bindtap="switchFilter"
      data-status="{{2}}">
      <text class="filter-text">已完成</text>
    </view>
    <view 
      class="filter-item {{currentFilter === 3 ? 'active' : ''}}"
      bindtap="switchFilter"
      data-status="{{3}}">
      <text class="filter-text">已取消</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{filteredOrders.length > 0}}">
    <view class="order-item" wx:for="{{filteredOrders}}" wx:key="id" bindtap="viewOrderDetail" data-id="{{item.id}}">
      <!-- 订单头部 -->
      <view class="order-header">
        <view class="order-info">
          <text class="order-number">订单号：{{item.orderNumber}}</text>
          <text class="order-time">{{item.createTime}}</text>
        </view>
        <view class="order-status" style="color: {{orderStatusColor[item.orderStatus]}}">
          {{orderStatusText[item.orderStatus]}}
        </view>
      </view>

      <!-- 订单商品列表 -->
      <view class="order-dishes">
        <view class="dishes-images">
          <image class="dish-image" wx:for="{{item.details}}" wx:for-item="detail" wx:key="id" src="{{detail.image}}" mode="aspectFill"></image>
        </view>
        <view class="order-summary">
          <text class="summary-price">¥{{item.totalAmount}}</text>
          <text class="summary-count">共{{item.totalQuantity}}件</text>
        </view>
      </view>

      <view class="order-footer">
        <view class="order-actions" catchtap="stopPropagation">
          <!-- 待支付状态 -->
          <view class="action-btn cancel-btn" wx:if="{{item.orderStatus === 1}}" bindtap="cancelOrder" data-id="{{item.id}}">取消订单</view>
          <view class="action-btn primary-btn" wx:if="{{item.orderStatus === 1}}" bindtap="continuePay" data-id="{{item.id}}">我要买单</view>
          
          <!-- 已完成状态 -->
          <view class="action-btn cancel-btn" wx:if="{{item.orderStatus === 2}}" bindtap="deleteOrder" data-id="{{item.id}}">删除订单</view>
          <view class="action-btn primary-btn" wx:if="{{item.orderStatus === 2}}" bindtap="reorder" data-id="{{item.id}}">再来一单</view>
          
          <!-- 已取消状态 -->
          <view class="action-btn cancel-btn" wx:if="{{item.orderStatus === 3}}" bindtap="deleteOrder" data-id="{{item.id}}">删除订单</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
  </view>
</view>
