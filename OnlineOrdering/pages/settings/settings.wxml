<!--pages/settings/settings.wxml-->
<view class="page">
  <!-- 个人信息 -->
  <view class="section">
    <view class="section-title">个人信息</view>
    
    <view class="setting-item" bindtap="changeAvatar">
      <text class="item-label">头像</text>
      <view class="item-right">
        <image class="avatar-preview" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <text class="item-arrow">›</text>
      </view>
    </view>

    <view class="setting-item" bindtap="changeNickname">
      <text class="item-label">昵称</text>
      <view class="item-right">
        <text class="item-value">{{userInfo.nickName}}</text>
        <text class="item-arrow">›</text>
      </view>
    </view>

    <view class="setting-item">
      <text class="item-label">性别</text>
      <view class="item-right">
        <text class="item-value">{{genderText}}</text>
        <text class="item-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-section">
    <view class="logout-btn" bindtap="logout">
      <text>退出登录</text>
    </view>
  </view>
</view>

<!-- 修改昵称弹窗 -->
<view class="modal" wx:if="{{showNicknameModal}}" catchtap="closeNicknameModal">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">修改昵称</text>
    </view>
    <view class="modal-body">
      <input 
        class="nickname-input" 
        value="{{newNickname}}" 
        placeholder="请输入昵称"
        maxlength="20"
        bindinput="onNicknameInput"
      />
    </view>
    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="closeNicknameModal">取消</view>
      <view class="modal-btn confirm" bindtap="confirmNickname">确定</view>
    </view>
  </view>
</view>
