/* pages/index/index.wxss */
page {
  background-color: #f5f5f5;
  height: 100vh;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 店铺头部 */
.shop-header {
  background-color: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.shop-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.shop-info {
  flex: 1;
}

.shop-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.shop-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.shop-tags {
  display: flex;
  gap: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999;
}

.tag-icon {
  margin-right: 4rpx;
  font-size: 24rpx;
}

.tag-text {
  font-size: 22rpx;
}

.table-number {
  position: absolute;
  right: 30rpx;
  top: 30rpx;
  border: 2rpx solid #ff6b35;
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
  display: flex;
  align-items: center;
  cursor: pointer;
  transition: all 0.3s;
}

.table-number:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.table-text {
  font-size: 26rpx;
  color: #ff6b35;
  margin-right: 4rpx;
}

.arrow {
  font-size: 32rpx;
  color: #ff6b35;
}

/* 主体内容 */
.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #fff;
}

/* 温馨提示 */
.notice {
  background-color: #fff9f0;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  margin: 12rpx 30rpx;
  border-radius: 8rpx;
}

.notice-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.notice-text {
  font-size: 24rpx;
  color: #ff8c00;
  flex: 1;
}

/* 内容包装器 */
.content-wrapper {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧分类 */
.category-sidebar {
  width: 160rpx;
  background-color: #f8f8f8;
}

.category-scroll {
  height: 100%;
}

.category-item {
  padding: 32rpx 0;
  text-align: center;
  position: relative;
  background-color: #f8f8f8;
}

.category-item.active {
  background-color: #fff;
}

.category-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background-color: #ff6b35;
  border-radius: 0 4rpx 4rpx 0;
}

.category-item.active .category-name {
  color: #333;
  font-weight: bold;
}

.category-name {
  font-size: 28rpx;
  color: #666;
}

.order-btn {
  margin-top: 40rpx;
  padding: 32rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.order-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.order-text {
  font-size: 24rpx;
  color: #666;
}

/* 右侧菜品 */
.dish-content {
  flex: 1;
  background-color: #fff;
}

.dish-scroll {
  height: 100%;
}

.section {
  padding: 0 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.more-link {
  font-size: 24rpx;
  color: #999;
}

.dish-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.dish-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.dish-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b35;
}

.dish-action {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.btn-minus,
.btn-plus {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.btn-minus {
  background-color: #f0f0f0;
  color: #666;
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  background-color: #ff6b35;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 36rpx;
  color: #fff;
  font-weight: 300;
}

.count {
  font-size: 28rpx;
  color: #333;
  min-width: 40rpx;
  text-align: center;
}

/* 底部购物车 */
.cart-bar {
  position: fixed;
  bottom: 10rpx;
  left: 20rpx;
  right: 20rpx;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  z-index: 100;
}

.cart-left {
  display: flex;
  align-items: center;
}

.cart-icon-wrapper {
  position: relative;
  margin-right: 20rpx;
}

.cart-icon {
  width: 88rpx;
  height: 88rpx;
  background-color: #ff6b35;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  position: relative;
  top: -20rpx;
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background-color: #ff3b30;
  color: #fff;
  border-radius: 50%;
  min-width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  padding: 0 8rpx;
}

.cart-info {
  display: flex;
  flex-direction: column;
}

.cart-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.cart-tip {
  font-size: 20rpx;
  color: #999;
}

.cart-btn {
  background-color: #ff6b35;
  color: #fff;
  padding: 20rpx 48rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
}


/* 口味选择弹窗 */
.flavor-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.flavor-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.flavor-dialog {
  width: 600rpx;
  background-color: #fff;
  border-radius: 24rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  margin: 0 40rpx;
}

.flavor-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.flavor-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.flavor-close-btn {
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
}

.flavor-close-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
}

.flavor-content {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

.flavor-section {
  margin-bottom: 30rpx;
}

.flavor-section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.flavor-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.flavor-option {
  padding: 16rpx 32rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.flavor-option.active {
  background-color: #fff5f0;
  color: #ff6b35;
  border-color: #ff6b35;
}

.flavor-footer {
  padding: 20rpx 10rpx 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flavor-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b35;
}

/* 按钮区域包装器 - 固定宽度 */
.flavor-btn-wrapper {
  width: 200rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 弹窗中的加减按钮 */
.flavor-action {
  display: flex;
  align-items: center;
  gap: 16rpx;
  justify-content: center;
}

.flavor-btn-minus,
.flavor-btn-plus {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.flavor-btn-minus {
  background-color: #f0f0f0;
  color: #666;
}

.flavor-btn-plus {
  background-color: #ff6b35;
  color: #fff;
}

.flavor-count {
  font-size: 28rpx;
  color: #333;
  min-width: 40rpx;
  text-align: center;
}

.flavor-confirm-btn {
  background-color: #ff6b35;
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  padding: 16rpx 24rpx;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
}


/* 购物车弹窗 */
.cart-dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 180rpx;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}

.cart-dialog {
  width: 100%;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 60vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 180rpx;
  margin-bottom: -180rpx;
}

.cart-dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.cart-dialog-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.cart-dialog-clear {
  font-size: 26rpx;
  color: #999;
}

.cart-dialog-content {
  flex: 1;
  padding: 0 30rpx;
  overflow-y: auto;
  max-height: calc(60vh - 90rpx);
}

.cart-dialog-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.cart-item-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.cart-item-info {
  flex: 1;
  margin-right: 20rpx;
}

.cart-item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.cart-item-flavor {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.cart-item-right {
  display: flex;
  align-items: center;
  margin-right: 60rpx;
}

.cart-item-bottom {
  display: flex;
  align-items: center;
  gap: 60rpx;
}

.cart-item-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b35;
}

.cart-item-action {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cart-item-btn-minus,
.cart-item-btn-plus {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.cart-item-btn-minus {
  background-color: #f0f0f0;
  color: #666;
}

.cart-item-btn-plus {
  background-color: #ff6b35;
  color: #fff;
}

.cart-item-count {
  font-size: 28rpx;
  color: #333;
  min-width: 40rpx;
  text-align: center;
}
