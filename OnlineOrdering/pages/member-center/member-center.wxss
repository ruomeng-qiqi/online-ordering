/* pages/member-center/member-center.wxss */
.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx 30rpx 40rpx;
}

/* 会员信息卡片 */
.member-card {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 53, 0.3);
}

.member-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.member-icon {
  font-size: 72rpx;
  margin-right: 24rpx;
}

.member-info {
  display: flex;
  flex-direction: column;
}

.member-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.member-name {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.member-details {
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 24rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.detail-value {
  font-size: 26rpx;
  color: #fff;
  font-weight: bold;
}

/* 积分信息 */
.points-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.points-cards {
  display: flex;
  gap: 20rpx;
}

.points-card {
  flex: 1;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.points-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b35;
  margin-bottom: 12rpx;
}

.points-label {
  font-size: 26rpx;
  color: #999;
}

/* 会员权益 */
.benefits-section {
  margin-bottom: 30rpx;
}

.benefit-list {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.benefit-item {
  margin-bottom: 32rpx;
}

.benefit-item:last-child {
  margin-bottom: 0;
}

.benefit-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.benefit-icon {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background-color: rgba(255, 107, 53, 0.1);
  color: #ff6b35;
  border-radius: 50%;
  font-size: 20rpx;
  margin-right: 16rpx;
}

.benefit-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.benefit-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-left: 52rpx;
}

/* 快捷入口 */
.quick-links {
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.link-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.link-item:last-child {
  border-bottom: none;
}

.link-text {
  font-size: 32rpx;
  color: #333;
}

.link-arrow {
  font-size: 48rpx;
  color: #d0d0d0;
  font-weight: 300;
}
