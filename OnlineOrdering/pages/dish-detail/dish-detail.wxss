/* pages/dish-detail/dish-detail.wxss */
.page {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 30rpx;
}

/* 菜品图片 */
.dish-image-wrapper {
  width: 100%;
  height: 500rpx;
  background-color: #fff;
}

.dish-image {
  width: 100%;
  height: 100%;
}

/* 菜品信息区域 */
.dish-info-section {
  background-color: #fff;
  margin: 20rpx 30rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dish-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.dish-price {
  font-size: 40rpx;
  color: #ff6b35;
  font-weight: bold;
}

.info-right {
  margin-left: 30rpx;
}

/* 商品详情区域 */
.detail-section {
  background-color: #fff;
  margin: 20rpx 30rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.detail-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 数量控制 */
.quantity-control {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.btn-minus,
.btn-plus {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  background-color: #ff6b35;
  color: #fff;
}

.quantity {
  min-width: 60rpx;
  text-align: center;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

/* 数量控制 */
.quantity-control {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.btn-minus,
.btn-plus {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
}

.btn-minus {
  background-color: #f0f0f0;
  color: #666;
}

.btn-plus {
  background-color: #ff6b35;
  color: #fff;
}

.quantity {
  min-width: 60rpx;
  text-align: center;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

/* 加入购物车按钮 */
.add-cart-btn {
  width: 200rpx;
  height: 70rpx;
  background-color: #ff6b35;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}

/* 口味选择弹窗 */
.flavor-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.flavor-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.flavor-dialog {
  width: 600rpx;
  background-color: #fff;
  border-radius: 24rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  margin: 0 40rpx;
}

.flavor-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.flavor-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.flavor-content {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

.flavor-section {
  margin-bottom: 30rpx;
}

.flavor-section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.flavor-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.flavor-option {
  padding: 16rpx 32rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.flavor-option.active {
  background-color: #fff5f0;
  color: #ff6b35;
  border-color: #ff6b35;
}

.flavor-footer {
  padding: 20rpx 10rpx 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flavor-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b35;
}

/* 按钮区域包装器 - 固定宽度 */
.flavor-btn-wrapper {
  width: 200rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 弹窗中的加减按钮 */
.flavor-action {
  display: flex;
  align-items: center;
  gap: 16rpx;
  justify-content: center;
}

.flavor-btn-minus,
.flavor-btn-plus {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.flavor-btn-minus {
  background-color: #f0f0f0;
  color: #666;
}

.flavor-btn-plus {
  background-color: #ff6b35;
  color: #fff;
}

.flavor-count {
  font-size: 28rpx;
  color: #333;
  min-width: 40rpx;
  text-align: center;
}

.flavor-confirm-btn {
  background-color: #ff6b35;
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  padding: 16rpx 24rpx;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
}

.flavor-close-btn {
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
}

.flavor-close-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
}
