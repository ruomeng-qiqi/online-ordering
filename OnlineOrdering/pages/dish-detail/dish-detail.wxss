/* pages/dish-detail/dish-detail.wxss */
.page {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 30rpx;
}

/* 菜品图片 */
.dish-image-wrapper {
  width: 100%;
  height: 500rpx;
  background-color: #fff;
}

.dish-image {
  width: 100%;
  height: 100%;
}

/* 菜品信息区域 */
.dish-info-section {
  background-color: #fff;
  margin: 20rpx 30rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dish-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.dish-price {
  font-size: 40rpx;
  color: #ff6b35;
  font-weight: bold;
}

.info-right {
  margin-left: 30rpx;
}

/* 商品详情区域 */
.detail-section {
  background-color: #fff;
  margin: 20rpx 30rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.detail-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 数量控制 */
.quantity-control {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.btn-minus,
.btn-plus {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  background-color: #ff6b35;
  color: #fff;
}

.quantity {
  min-width: 60rpx;
  text-align: center;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

/* 加入购物车按钮 */
.add-cart-btn {
  width: 200rpx;
  height: 70rpx;
  background-color: #ff6b35;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}
