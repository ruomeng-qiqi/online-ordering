/* pages/points-record/points-record.wxss */
.page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 非会员引导页 */
.non-member-guide {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
  background: linear-gradient(180deg, #fff 0%, #f5f5f5 100%);
}

.guide-icon {
  font-size: 160rpx;
  margin-bottom: 40rpx;
}

.guide-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.guide-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 60rpx;
}

.guide-benefits {
  width: 100%;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 60rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.benefit-item {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.benefit-item:last-child {
  margin-bottom: 0;
}

.benefit-icon {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background-color: rgba(255, 107, 53, 0.1);
  color: #ff6b35;
  border-radius: 50%;
  font-size: 24rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.benefit-text {
  font-size: 30rpx;
  color: #333;
}

.guide-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.3);
}

/* 会员内容 */
.member-content {
  padding: 30rpx;
}

/* 积分统计卡片 */
.points-summary {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
  position: relative;
}

.summary-content {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.summary-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.summary-divider {
  width: 2rpx;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

/* 去使用按钮 */
.use-points-btn {
  position: absolute;
  top: 5rpx;
  right: 5rpx;
  padding: 12rpx 28rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #ff6b35;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 积分记录列表 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.record-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-right {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.record-points {
  font-size: 36rpx;
  font-weight: bold;
}

.record-points-add {
  color: #67c23a;
}

.record-points-minus {
  color: #f56c6c;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
