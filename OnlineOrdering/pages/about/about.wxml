<!--pages/about/about.wxml-->
<view class="page">
  <!-- 餐厅Logo和名称 -->
  <view class="header-section">
    <image class="logo" src="/assets/hero.png" mode="aspectFit"></image>
    <text class="restaurant-name">在线点餐系统</text>
    <text class="slogan">美味佳肴，一键到桌</text>
  </view>

  <!-- 餐厅介绍 -->
  <view class="section">
    <view class="section-title">
      <text class="title-text">餐厅介绍</text>
    </view>
    <text class="intro-text">我们致力于为顾客提供优质的用餐体验，精选新鲜食材，用心烹饪每一道菜品。通过智能点餐系统，让您享受便捷高效的服务，品味地道美食。</text>
  </view>

  <!-- 联系方式 -->
  <view class="section">
    <view class="section-title">
      <text class="title-text">联系方式</text>
    </view>
    <view class="contact-list">
      <view class="contact-item">
        <text class="contact-label">客服电话</text>
        <text class="contact-value" bindtap="makePhoneCall" data-phone="400-123-4567">400-123-4567</text>
      </view>
      <view class="contact-item">
        <text class="contact-label">营业时间</text>
        <text class="contact-value">周一至周日 10:00-22:00</text>
      </view>
      <view class="contact-item">
        <text class="contact-label">餐厅地址</text>
        <text class="contact-value">北京市朝阳区xx路xx号</text>
      </view>
    </view>
  </view>

  <!-- 服务特色 -->
  <view class="section">
    <view class="section-title">
      <text class="title-text">服务特色</text>
    </view>
    <view class="feature-list">
      <view class="feature-item">
        <view class="feature-content">
          <text class="feature-title">精选食材</text>
          <text class="feature-desc">严选优质食材，确保新鲜健康</text>
        </view>
      </view>
      <view class="feature-item">
        <view class="feature-content">
          <text class="feature-title">快速上菜</text>
          <text class="feature-desc">智能点餐系统，高效便捷</text>
        </view>
      </view>
      <view class="feature-item">
        <view class="feature-content">
          <text class="feature-title">会员积分</text>
          <text class="feature-desc">消费获积分，积分抵现金</text>
        </view>
      </view>
      <view class="feature-item">
        <view class="feature-content">
          <text class="feature-title">贴心服务</text>
          <text class="feature-desc">专业团队，用心服务每位顾客</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-section">
    <text class="version-text">版本号：v1.0.0</text>
  </view>
</view>
