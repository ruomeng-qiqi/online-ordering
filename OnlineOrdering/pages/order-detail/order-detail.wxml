<!--pages/order-detail/order-detail.wxml-->
<view class="page">
  <scroll-view scroll-y class="content">
    <!-- 订单状态卡片 -->
    <view class="section status-section status-section-{{order.orderStatus}}">
      <view class="status-header">
        <view class="status-info">
          <text class="order-number">订单号：{{order.orderNumber}}</text>
          <view class="status-tag status-{{order.orderStatus}}">
            <text>{{orderStatusText}}</text>
          </view>
        </view>
        <text class="create-time">下单时间：{{order.createTime}}</text>
        <text class="create-time" wx:if="{{order.orderStatus === 2 && order.checkoutTime}}">支付时间：{{order.checkoutTime}}</text>
        <text class="create-time" wx:if="{{order.orderStatus === 3 && order.updateTime}}">取消时间：{{order.updateTime}}</text>
      </view>
    </view>

    <!-- 订单信息 -->
    <view class="section">
      <view class="section-title">订单信息</view>
      <view class="info-row">
        <text class="info-label">桌号</text>
        <text class="info-value">{{order.tableNumber}}</text>
      </view>
      <view class="info-row" wx:if="{{order.checkoutTime}}">
        <text class="info-label">结账时间</text>
        <text class="info-value">{{order.checkoutTime}}</text>
      </view>
      <view class="info-row" wx:if="{{order.paymentMethod}}">
        <text class="info-label">支付方式</text>
        <text class="info-value">{{paymentMethodText}}</text>
      </view>
    </view>

    <!-- 菜品明细 -->
    <view class="section">
      <view class="section-title">菜品明细</view>
      <view class="dish-list">
        <view class="dish-item" wx:for="{{orderDetails}}" wx:key="id">
          <image class="dish-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="dish-info">
            <text class="dish-name">{{item.name}}</text>
            <text class="dish-flavor" wx:if="{{item.flavorText}}">{{item.flavorText}}</text>
          </view>
          <view class="dish-right">
            <text class="dish-price">¥{{item.price}}</text>
            <text class="dish-quantity">×{{item.quantity}}</text>
          </view>
        </view>
      </view>
      
      <!-- 金额汇总 -->
      <view class="amount-summary">
        <view class="summary-item">
          <text class="summary-label">订单总额</text>
          <text class="summary-value">¥{{order.totalAmount}}</text>
        </view>
        <view class="summary-item" wx:if="{{order.discountAmount > 0}}">
          <text class="summary-label">优惠金额</text>
          <text class="summary-value discount">-¥{{order.discountAmount}}</text>
        </view>
        <view class="summary-item" wx:if="{{order.pointsDeduction > 0}}">
          <text class="summary-label">积分抵扣</text>
          <text class="summary-value discount">-¥{{order.pointsDeduction}} ({{order.pointsUsed}}积分)</text>
        </view>
        <view class="summary-item total">
          <text class="summary-label">{{order.orderStatus === 2 ? '实付金额' : '应付金额'}}</text>
          <text class="summary-value">¥{{actualAmount}}</text>
        </view>
        <view class="summary-item" wx:if="{{order.orderStatus === 2 && order.pointsEarned > 0}}">
          <text class="summary-label">获得积分</text>
          <text class="summary-value earned">+{{order.pointsEarned}}积分</text>
        </view>
      </view>
    </view>

    <!-- 订单备注 -->
    <view class="section" wx:if="{{order.remark}}">
      <view class="section-title">订单备注</view>
      <text class="remark-text">{{order.remark}}</text>
    </view>

    <!-- 底部占位 -->
    <view class="bottom-placeholder"></view>
  </scroll-view>

  <!-- 底部操作栏 - 待支付（两个按钮） -->
  <view class="footer footer-two-btns" wx:if="{{order.orderStatus === 1}}">
    <view class="footer-btn secondary" bindtap="continueShopping">
      <text>继续点餐</text>
    </view>
    <view class="footer-btn primary" bindtap="goToPay">
      <text>我要买单</text>
    </view>
  </view>

  <!-- 已完成订单底部操作栏（两个按钮） -->
  <view class="footer footer-two-btns" wx:if="{{order.orderStatus === 2}}">
    <view class="footer-btn secondary" bindtap="deleteOrder">
      <text>删除订单</text>
    </view>
    <view class="footer-btn primary" bindtap="reorder">
      <text>再来一单</text>
    </view>
  </view>

  <!-- 已取消订单底部操作栏（一个按钮） -->
  <view class="footer footer-one-btn" wx:if="{{order.orderStatus === 3}}">
    <view class="footer-btn secondary" bindtap="deleteOrder">
      <text>删除订单</text>
    </view>
  </view>
</view>
