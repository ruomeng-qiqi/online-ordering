/* pages/order-detail/order-detail.wxss */
.page {
  width: 100%;
  height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

/* 内容区域 */
.content {
  flex: 1;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

/* 区块样式 */
.section {
  background-color: #fff;
  margin: 20rpx 30rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section:first-child {
  margin-top: 20rpx;
}

.section:last-child {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

/* 底部占位 */
.bottom-placeholder {
  height: 140rpx;
}

/* 订单状态卡片 */
.status-section {
  color: #fff;
}

/* 待支付 - 橙色 */
.status-section-1 {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
}

/* 已完成 - 绿色 */
.status-section-2 {
  background: linear-gradient(135deg, #67c23a 0%, #85ce61 100%);
}

/* 已取消 - 灰色 */
.status-section-3 {
  background: linear-gradient(135deg, #909399 0%, #a6a9ad 100%);
}

.status-header {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.status-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-number {
  font-size: 28rpx;
  color: #fff;
  opacity: 0.9;
}

.status-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.status-tag.status-1 {
  background-color: rgba(255, 255, 255, 0.3);
}

.status-tag.status-2 {
  background-color: rgba(103, 194, 58, 0.3);
}

.status-tag.status-3 {
  background-color: rgba(144, 147, 153, 0.3);
}

.create-time {
  font-size: 24rpx;
  color: #fff;
  opacity: 0.8;
}

/* 订单信息 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

/* 菜品列表 */
.dish-list {
  display: flex;
  flex-direction: column;
}

.dish-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.dish-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.dish-flavor {
  font-size: 24rpx;
  color: #999;
}

.dish-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 20rpx;
}

.dish-price {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.dish-quantity {
  font-size: 24rpx;
  color: #999;
}

/* 金额汇总 */
.amount-summary {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.summary-item.total {
  border-top: 1rpx solid #e0e0e0;
  margin-top: 12rpx;
  padding-top: 20rpx;
}

.summary-label {
  font-size: 28rpx;
  color: #666;
}

.summary-value {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.summary-value.discount {
  color: #67c23a;
}

.summary-value.earned {
  color: #67c23a;
}

.summary-item.total .summary-label {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.summary-item.total .summary-value {
  font-size: 36rpx;
  color: #ff6b35;
}

/* 备注 */
.remark-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 底部操作栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  min-height: 100rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  gap: 20rpx;
}

/* 两个按钮时左右分布 */
.footer-two-btns {
  justify-content: space-between;
}

/* 一个按钮时靠右 */
.footer-one-btn {
  justify-content: flex-end;
}

.footer-btn {
  min-width: 140rpx;
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
  white-space: nowrap;
}

.footer-btn.secondary {
  background-color: #fff;
  border: 2rpx solid #ff6b35;
  color: #ff6b35;
}

.footer-btn.primary {
  background-color: #ff6b35;
  color: #fff;
}
